# ============================================================
# Rapid Screening API - Configuração de Ambiente
# ============================================================

# Porta HTTP do servidor Go local
PORT=8080

# Caminho do arquivo de persistência L2 (em Vercel serverless usa automaticamente /tmp)
DATA_FILE=data/trackings.json

# Cache L1 e proteção anti-desperdício de créditos
# (DELIVERED usa automaticamente 24h; AT_CDD/OUT_FOR_DELIVERY usam até 10 min)
CACHE_TTL_MINUTES=15
REFRESH_COOLDOWN_SECONDS=60

# Segurança, CORS e Rate Limiting por IP
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30

# Segredo opcional para validação dos webhooks (/api/v1/webhooks/17track e /trackingmore)
# Se vazio, aceita webhooks sem validação de assinatura (modo desenvolvimento)
WEBHOOK_SECRET=

# ============================================================
# Provedores de Rastreamento (Cascata anti-gasto de créditos)
# ============================================================

# Camada 1: Consulta direta gratuita (Correios / endpoints públicos sem consumo de créditos)
FREE_DIRECT_ENABLED=true
FREE_DIRECT_BASE_URL=

# Camada 2: 17TRACK API v2.2 (opcional — deixe vazio para operar 100% gratuito/demo)
TRACK17_API_KEY=
TRACK17_MONTHLY_CREDITS=100
TRACK17_BASE_URL=

# Camada 3: TrackingMore API v4 (opcional — failover automático quando 17TRACK esgotar)
TRACKINGMORE_API_KEY=
TRACKINGMORE_MONTHLY_CREDITS=50
TRACKINGMORE_BASE_URL=

# ============================================================
# Persistência Gratuita na Vercel (Upstash Redis REST / Vercel KV)
# Opcional: mantém cache compartilhado entre cold starts da Vercel via HTTP REST
# ============================================================
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# (Compatível também com KV_REST_API_URL e KV_REST_API_TOKEN)

# ============================================================
# Infraestrutura Local / Docker (PostgreSQL 16 + Redis 7)
# ============================================================
# DATABASE_URL=postgres://rapid:rapid@localhost:5432/rapid_screening?sslmode=disable
# REDIS_URL=redis://localhost:6379/0
